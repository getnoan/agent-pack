# --- required for every agent ---
NOAN_PERSONAL_API_KEY=npak_your_key_here
ANTHROPIC_API_KEY=sk-ant-your_key_here
RESEND_API_KEY=re_your_key_here

# --- which model answers ---
# The agents are not tied to one vendor. They speak the Anthropic Messages wire
# format, and ANTHROPIC_BASE_URL points that at whoever you like:
#
#   Anthropic          leave both of these unset. Nothing else to do.
#   OpenRouter         ANTHROPIC_BASE_URL=https://openrouter.ai/api
#                      LLM_API_KEY=<your OpenRouter key>, and set the *_MODEL
#                      variables below to ids it knows. No proxy to run.
#   Your own gateway   ANTHROPIC_BASE_URL=http://localhost:4000 (LiteLLM and
#                      similar translate to OpenAI, Gemini, Bedrock, Azure...)
#
# What does NOT work is pointing this at a provider's own OpenAI-shaped URL
# (api.openai.com and the like): those speak a different request format, so a
# gateway has to sit in between. A run on a non-Anthropic endpoint says once,
# naming the host, that prompt caching and extended thinking may be ignored
# there — a gateway that drops them still answers 200, so the bill would
# otherwise be the only symptom.
ANTHROPIC_BASE_URL=
# Either name works for the key. ANTHROPIC_API_KEY above is canonical; use this
# one instead when your endpoint is not Anthropic and that name would be a lie.
LLM_API_KEY=
#
# Model ids, per agent. Unset means claude-opus-5, which only resolves on an
# Anthropic-backed endpoint — so if you set ANTHROPIC_BASE_URL, set these too.
FACT_ALIGNMENT_MODEL=
MARKET_RESEARCH_MODEL=
ACTIVITY_REPORT_MODEL=
CS_MODEL=
REPLY_DRAFT_MODEL=
COMMAND_MODEL=
SCHEDULE_MODEL=
AUDIT_EXTRACT_MODEL=
AUDIT_ANALYSIS_MODEL=
# The sales deck is Python with its own client, but follows the same variables.
# Its model ids are these two; design/config.json still wins where both are unset.
DESIGN_MODEL=
COVER_MODEL=

# Who the agents send mail as. The sending domain must be verified in Resend.
MAIL_FROM=Your Agent <agent@example.com>
# A monitored inbound address. Replies to an agent's mail land here — if this
# is wrong, a reply reaches nobody and nothing errors.
REPLY_TO=agent@example.com
# Where an agent escalates when it needs a human. No default on purpose.
ESCALATE_TO=

# --- who the agents are ---
# The agents carry no company in their code. Leave these unset and they sign as
# "Agent", name your company from your NOAN workspace's project name, treat only
# the COMMANDERS list as teammates, and put no hyperlinks in what they send.
AGENT_NAME=
# she/her, he/him, or leave unset for they/them — how the agents' own prose refers to them.
AGENT_PRONOUNS=
# Your company's name in prompts. Unset = your NOAN project's name.
COMPANY_NAME=
# The NOAN identity ids the agents run as: the `identity.id` that GET /me returns for the
# account whose key the agents use (and the id humans pick when they assign the agent). Comma-separated.
AGENT_IDENTITY_IDS=
# Addresses that may steer the agents by email or task comment. Comma-separated. Unset = nobody.
COMMANDERS=
# Everyone at this domain also counts as a teammate (e.g. example.com). Unset = only COMMANDERS.
TEAMMATE_DOMAIN=
# The only hyperlinks a reply may contain, comma-separated. Unset = no links.
AGENT_ALLOWED_LINKS=
# Contacts carrying this tag receive the report emails (activity, fact alignment, market research).
REPORT_RECIPIENT_TAG=
# Optional: a logo and a fonts directory for the report/newsletter email shell.
EMAIL_WORDMARK_URL=
EMAIL_FONTS_URL=
# Optional: the default time zone for scheduling replies (IANA name). Unset = UTC.
SCHEDULE_TIMEZONE=

# --- state ledger (5 of the 6 agents need one) ---
STATE_BACKEND=postgres
DATABASE_URL=postgres://user:password@host:5432/postgres
# Or, self-hosting on a machine with a disk:
# STATE_BACKEND=local

# --- safe mode: on until you deliberately turn it off, per agent ---
DRY_RUN=1
# Support agent only: while set, replies AND escalation forwards go here.
TEST_RECIPIENT=

# --- per-agent extras ---
# market research
FIRECRAWL_API_KEY=

# --- block slugs, printed by each seed script when you run it ---
ACTIVITY_REPORT_CONFIG_BLOCK_SLUG=
ACTIVITY_REPORT_PLAYBOOK_BLOCK_SLUG=
FACT_ALIGNMENT_CONFIG_BLOCK_SLUG=
FACT_ALIGNMENT_PLAYBOOK_BLOCK_SLUG=
MARKET_RESEARCH_STACK_SLUG=
MARKET_RESEARCH_CONFIG_BLOCK_SLUG=
MARKET_RESEARCH_PLAYBOOK_BLOCK_SLUG=
DECK_CONFIG_BLOCK_SLUG=
DECK_PLAYBOOK_BLOCK_SLUG=
REPLY_CONFIG_BLOCK_SLUG=
REPLY_PLAYBOOK_BLOCK_SLUG=
CS_CONFIG_BLOCK_SLUG=
